---
// Otete is a full-screen app, so this page deliberately does NOT use BaseLayout:
//
//  - the site header (logo + dark-mode toggle) sat on top of the app's own
//    Header, and the app already has its own theme toggle, so the two overlapped
//    And duplicated each other;
//  - the viewport has to be the app's own: `viewport-fit=cover` so
//    Env(safe-area-inset-*) works on notched phones, and no pinch-zoom, because
//    A toddler's fingers are not precise.
//
// The app owns the screen; /apps/ is how you get in and out of it.
import { App as OteteApp } from "@mijime/otete";
import "@mijime/otete/index.css";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
    />
    <meta name="theme-color" content="#faf8f3" id="tmc" />
    <link rel="manifest" href="/apps/otete/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/otete-180.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="otete" />
    <title>otete</title>
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <!-- Set the app's theme before first paint to avoid a flash. -->
    <script is:inline>
      (() => {
        const stored = (() => {
          try {
            return localStorage.getItem("kids-theme");
          } catch {
            return null;
          }
        })();
        const dark = stored
          ? stored === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
  </head>
  <body>
    <OteteApp client:only="react" />
    <script is:inline>
      (() => {
        if (!("serviceWorker" in navigator)) return;
        const isDev =
          location.hostname === "localhost" ||
          location.hostname === "127.0.0.1" ||
          location.port !== "";

        if (isDev) {
          const key = "sw-dev-clean-v2";
          try {
            if (sessionStorage.getItem(key)) return;
          } catch {}
          const cleanup = [
            navigator.serviceWorker
              .getRegistrations()
              .then((registrations) =>
                Promise.all(registrations.map((registration) => registration.unregister())),
              ),
          ];
          if ("caches" in window) {
            cleanup.push(
              caches
                .keys()
                .then((keys) => Promise.all(keys.map((cacheKey) => caches.delete(cacheKey)))),
            );
          }
          Promise.all(cleanup).then(() => {
            try {
              sessionStorage.setItem(key, "1");
            } catch {}
            location.reload();
          });
          return;
        }

        let refreshing = false;
        navigator.serviceWorker.addEventListener("controllerchange", () => {
          if (refreshing) return;
          refreshing = true;
          location.reload();
        });
        window.addEventListener("load", () => {
          navigator.serviceWorker
            .register("/sw.js", { updateViaCache: "none" })
            .catch(() => {});
        });
      })();
    </script>
  </body>
</html>
