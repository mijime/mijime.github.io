---
// Parent pages (the toy box and 🖼️ gallery) set data-otete-view="chrome" on
// <html> and live under the site header like every other app page. Toddler
// activity screens flip it to "play" and go full-screen, hiding the header
// (see otete/src/styles.css).
//
// The viewport still has to be the app's own: `viewport-fit=cover` so
// Env(safe-area-inset-*) works on notched phones, and no pinch-zoom, because
// a toddler's fingers are not precise.
import { App as OteteApp } from "@mijime/otete";
import BaseLayout from "../../layouts/base-layout.astro";
import "@mijime/otete/index.css";
---

<BaseLayout
  title="otete"
  manifest="/apps/otete/manifest.webmanifest"
  themeColor="#96661d"
  app="otete"
  description="toddler activity box"
  appName="otete"
  icon="/icons/otete-180.png"
  viewport="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover"
>
  <OteteApp client:only="react" />
</BaseLayout>
