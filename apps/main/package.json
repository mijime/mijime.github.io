{
  "name": "@mijime/main",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node --experimental-wasm-modules ../../packages/blog/scripts/generate-parquet.mjs && astro build",
    "preview": "astro preview",
    "check": "pnpm run check:format && pnpm run check:oxlint && pnpm run check:astro",
    "check:format": "oxfmt --check src",
    "check:oxlint": "oxlint --format=github --fix",
    "check:astro": "astro check",
    "format": "pnpm run format:oxfmt",
    "format:oxfmt": "oxfmt src"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/react": "^7.1.0",
    "@mijime/blog": "workspace:*",
    "@mijime/emolog": "workspace:*",
    "@mijime/lords-of-the-stigmata": "workspace:*",
    "@mijime/madories": "workspace:*",
    "@mijime/mintodo": "workspace:*",
    "@mijime/otete": "workspace:*",
    "@mijime/saiflow": "workspace:*",
    "@mijime/theme": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "astro": "^7.4.0",
    "lucide-react": "^1.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
