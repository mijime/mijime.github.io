{
  "name": "@mijime/otete",
  "version": "2.0.0",
  "description": "A tactile toddler toy box: feeding, bubbles, shape sorter, train tracing, musical drawing, numbers, picture book & magic mirror",
  "type": "module",
  "exports": {
    ".": "./src/components/App.tsx",
    "./index.css": "./src/styles.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "check": "pnpm run check:format && pnpm run check:types && pnpm run check:oxlint",
    "check:format": "oxfmt --check",
    "check:types": "tsc --noEmit",
    "check:oxlint": "oxlint --format=github --fix",
    "format": "pnpm run format:oxfmt",
    "format:oxfmt": "oxfmt"
  },
  "dependencies": {
    "@mijime/theme": "workspace:*",
    "dexie": "^4.4.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "7.1.0-dev.20261015.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
