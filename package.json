{
  "name": "mijime.github.io",
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm --filter @mijime/main dev",
    "sim": "node apps/saiflow/src/cli.ts",
    "preview": "pnpm --filter @mijime/main preview",
    "build": "pnpm -r run build",
    "check": "pnpm -r run check",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "format": "pnpm -r run format"
  },
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
