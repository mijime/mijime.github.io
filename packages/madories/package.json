{
  "name": "@mijime/madories",
  "version": "1.0.0",
  "description": "A browser-based floor plan editor",
  "type": "module",
  "exports": {
    ".": "./src/components/App.tsx",
    "./index.css": "./src/index.css"
  },
  "scripts": {
    "test": "vitest run",
    "check": "pnpm run check:format && pnpm run check:tsgo && pnpm run check:oxlint",
    "check:format": "oxfmt --check",
    "check:tsgo": "tsgo --noEmit",
    "check:oxlint": "oxlint --format=github --fix",
    "format": "pnpm run format:oxfmt",
    "format:oxfmt": "oxfmt"
  },
  "dependencies": {
    "@mijime/theme": "workspace:*",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "dexie": "^4.4.7",
    "lucide-react": "^1.61.0",
    "three": "^0.186.1",
    "uqr": "^0.1.3",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "fake-indexeddb": "^6.2.6",
    "jsqr": "^1.4.0",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
