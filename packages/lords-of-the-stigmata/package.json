{
  "name": "@mijime/lords-of-the-stigmata",
  "version": "1.0.0",
  "description": "聖痕の支配者たち — 3D（Vite + TypeScript 版）",
  "type": "module",
  "exports": {
    ".": "./src/components/App.tsx",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsgo --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "pnpm run check:format && pnpm run check:tsgo && pnpm run check:oxlint",
    "check:format": "oxfmt --check",
    "check:tsgo": "tsgo --noEmit",
    "check:oxlint": "oxlint --format=github --fix",
    "format": "pnpm run format:oxfmt",
    "format:oxfmt": "oxfmt",
    "sim": "tsx scripts/sim.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "i18next": "^26.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.16",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
