{
  "name": "@mijime/lords-of-the-stigmata",
  "version": "1.0.0",
  "description": "聖痕の支配者たち — 3D（Vite + TypeScript 版）",
  "type": "module",
  "exports": {
    ".": "./src/components/App.tsx",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsgo --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "pnpm run check:format && pnpm run check:tsgo && pnpm run check:oxlint",
    "check:format": "oxfmt --check",
    "check:tsgo": "tsgo --noEmit",
    "check:oxlint": "oxlint --format=github --fix",
    "format": "pnpm run format:oxfmt",
    "format:oxfmt": "oxfmt",
    "sim": "tsx scripts/sim.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "i18next": "^23.16.8",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^14.1.3",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.169.0",
    "@typescript/native-preview": "7.0.0-dev.20260604.1",
    "@vitejs/plugin-react": "^4.7.0",
    "oxfmt": "^0.54.0",
    "oxlint": "^1.72.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
