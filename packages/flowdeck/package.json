{
  "name": "@mijime/flowdeck",
  "version": "0.1.0",
  "description": "Flowdeck — チームで流れをつくる協力型デッキ構築カンバン",
  "type": "module",
  "exports": {
    ".": "./src/App.tsx",
    "./index.css": "./src/index.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsgo --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "pnpm run check:format && pnpm run check:tsgo && pnpm run check:oxlint",
    "check:format": "oxfmt --check",
    "check:tsgo": "tsgo --noEmit",
    "check:oxlint": "oxlint --format=github --fix",
    "format": "pnpm run format:oxfmt",
    "format:oxfmt": "oxfmt",
    "sim": "tsx scripts/sim.ts",
    "mc": "tsx scripts/sim.ts -- --mc",
    "benchmark": "tsx scripts/sim.ts -- --benchmark --runs 1000 --out src/data/benchmark.json",
    "tasks": "tsx scripts/tasks.ts"
  },
  "dependencies": {
    "@mijime/theme": "workspace:*",
    "lucide-react": "^1.61.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
